{
  "name": "earth-plan",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:all": "pnpm build && pnpm build-storybook --quiet",
    "preview": "vite preview --port 4173",
    "lint": "eslint",
    "lint:fsd": "steiger ./src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "test:storybook": "vitest run --project storybook",
    "lighthouse": "lhci autorun",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist/client/storybook",
    "data:elevation": "node scripts/build-elevation.mjs",
    "poster": "node scripts/capture-globe-poster.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "^1.65.0",
    "@react-three/test-renderer": "9.1.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/eslint-config": "0.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jpeg-js": "^0.4.4",
    "jsdom": "^31.0.0",
    "netcdfjs": "^4.0.0",
    "playwright": "1.65.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "steiger": "0.10.0",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
